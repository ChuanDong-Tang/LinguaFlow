{
  "name": "mobile-expo",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node ./scripts/patch-picovoice-voice-processor.js",
    "start": "expo start",
    "preandroid": "expo prebuild --platform android --no-install",
    "android": "expo run:android",
    "preios": "expo prebuild --platform ios --no-install",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "build:ios:testflight": "npx eas-cli build --platform ios --profile testflight",
    "build:ios:production": "npx eas-cli build --platform ios --profile production",
    "publish:update": "node --env-file-if-exists=../../.env --env-file-if-exists=.env ./scripts/publish-self-hosted-update.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@picovoice/react-native-voice-processor": "^1.2.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.23",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.12",
    "expo-build-properties": "~57.0.20",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-iap": "5.4.1",
    "expo-image-manipulator": "~57.0.18",
    "expo-image-picker": "~57.0.18",
    "expo-media-library": "~57.0.5",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.22.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-sortables": "^1.10.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.12",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "ws@7.5.10": "7.5.11"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-keyboard-controller"
      ]
    }
  },
  "private": true
}
