{
  "name": "@lf/server",
  "private": true,
  "type": "module",
  "exports": {
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "test": "node --import tsx --test src/**/*.test.ts",
    "dev:worker": "node --env-file-if-exists=../.env --import tsx worker.dev.mjs",
    "start:worker": "node --env-file-if-exists=../.env --import tsx worker.dev.mjs",
    "start:worker:payment": "LF_WORKER_GROUP=payment node --env-file-if-exists=../.env --import tsx worker.dev.mjs",
    "start:worker:card": "LF_WORKER_GROUP=card node --env-file-if-exists=../.env --import tsx worker.dev.mjs",
    "start:worker:tts": "LF_WORKER_GROUP=tts node --env-file-if-exists=../.env --import tsx worker.dev.mjs",
    "start:worker:maintenance": "LF_WORKER_GROUP=maintenance node --env-file-if-exists=../.env --import tsx worker.dev.mjs"
  },
  "dependencies": {
    "cos-nodejs-sdk-v5": "^3.0.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "sentencex": "1.0.30",
    "sharp": "^0.35.3",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
