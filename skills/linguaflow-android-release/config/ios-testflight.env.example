# Copy this file to ios-testflight.env and fill in the values for the release
# environment. ios-testflight.env is intentionally ignored by Git.
# Use the local-credentials profile after downloading the existing EAS
# distribution certificate and provisioning profile into ignored local files.
BUILD_PROFILE=testflight-local
SUBMIT_PROFILE=production
# For a new native release, this must be above the highest App Store Connect
# version. IOS_RUNTIME_VERSION normally advances with IOS_APP_VERSION.
IOS_APP_VERSION=
IOS_RUNTIME_VERSION=
EXPECTED_BUNDLE_ID=
EXPECTED_CHANNEL=production
EXPECTED_API_URL=
EXPECTED_UPDATE_URL=
EXPECTED_TEAM_ID=
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=
